# CINESTUDIO AI — o que não entra no repositório
# Vídeos, áudio pesado, caches, ambientes e qualquer arquivo acima de 10 MB.
# A lista explícita no final foi gerada em 2026-11-10 com: find . -type f -size +10M

# Vídeo
*.mp4
*.mov
*.mkv
*.webm
*.avi

# Áudio pesado
*.wav
*.flac
*.aiff
*.aif
*.m4a

# MP3 de prévia com 2 MB ou mais (os menores de 2 MB entram)
bible/audio/sfx/wind-borgory-751473.mp3
bible/audio/sfx/chain-bruno-670853.mp3

# Pastas de mídia intermediária e alternativas
stems/
frames/
alternativas/
qc/
**/qc_preview/
**/p07_debug/

# Ambientes, caches e segredos
__pycache__/
*.pyc
.venv/
venv/
piper-venv/
node_modules/
.env
.env.*
!.env.example
*.log
*.pid
.DS_Store
Thumbs.db

# Modelos e binários pesados (também cobertos pela lista >10 MB)
*.onnx
*.so

